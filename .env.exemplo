# Copie este arquivo para .env e preencha com a connection string do seu projeto Supabase.
# O .env está no .gitignore e nunca vai para o repositório.
# No GitHub Actions o mesmo valor fica no secret SUPABASE_DB_URL.

# Supabase > Connect > Session pooler (URI). Troque [YOUR-PASSWORD] pela senha do banco, sem os colchetes.
SUPABASE_DB_URL=postgresql://postgres.SEU-PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
